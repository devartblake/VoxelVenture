[Unit]
Description=VoxelVenture API (accounts, claims, statistics)
After=network.target

[Service]
Type=simple
User=voxel
WorkingDirectory=/srv/voxelventure
EnvironmentFile=/etc/voxelventure/api.env
# One API process only: the database is SQLite, which has a single writer.
ExecStart=/usr/bin/node --experimental-sqlite --no-warnings services/api/server.mjs
Restart=always
RestartSec=3
# Hardening: the process can write only to its data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/voxelventure/services/api/data

[Install]
WantedBy=multi-user.target
