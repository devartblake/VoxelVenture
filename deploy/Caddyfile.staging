# Staging (deploy/STAGING.md): a second copy of the game on the same machine, on its own ports, with its own database and secrets. It is
# for the business journeys (tests/journeys/) and deploy rehearsals, not for the public: search engines are told to stay away, and every
# internal address answers 404. The admin pages are there, behind their own sign-in, as in production (staging has its own admin accounts). `deploy/staging.sh setup` copies this file to /etc/caddy/staging.caddy and imports it
# from /etc/caddy/Caddyfile.
# DNS: A records for staging, api.staging and play.staging under voxelventure.app, pointing at the Linode (deploy/STAGING.md).

# Security headers on every address (docs/operations/voxelventure_security_action_plan.md, V1; the same as production). Browsers only honour HSTS over HTTPS, which Caddy serves.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
		-Server
	}
}

# The game's Content-Security-Policy, REPORT-ONLY first (V2): nothing is blocked, violations are posted to the API's /csp-report (logged). Read the log across
# a full session (walk, claim a plot, open a listing, wardrobe, checkout), then move to an enforcing policy built on a per-request nonce
# (script-src 'unsafe-inline' here is only because Next.js injects inline bootstrap scripts; it must go before the policy is enforced).
# 'wasm-unsafe-eval' and blob: are for the Draco/KTX2/GLTF loaders and workers; the props bucket is the Object Storage host in web.env.
(csp_report_only) {
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {args[0]}; media-src 'self' blob: {args[0]}; font-src 'self' data:; connect-src 'self' blob: data: {args[1]} {args[2]} {args[0]}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri {args[1]}/csp-report"
}

# The game (Next.js, port 3100).
staging.voxelventure.app {
	encode zstd gzip
	import security_headers
	import csp_report_only https://vv-asset-prod.us-east-1.linodeobjects.com https://api.staging.voxelventure.app wss://play.staging.voxelventure.app
	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		respond <<ROBOTS
			User-agent: *
			Disallow: /
			ROBOTS 200
	}
	# the admin pages sign in against staging's own API (its own accounts, its own ADMIN_TOKEN); the presence status is read through it
	# (GET /admin/presence), never from here
	handle /mp-status {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

# The API (port 3102).
api.staging.voxelventure.app {
	encode zstd gzip
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	@internal path /internal /internal/*
	respond @internal 404
	reverse_proxy 127.0.0.1:3102
}

# Presence (WebSockets, port 3101). As in production, only the game's connection and the health check are public.
play.staging.voxelventure.app {
	import security_headers
	@private path /status /status/* /notify /notify/* /notify-accounts /notify-accounts/*
	respond @private 404
	reverse_proxy 127.0.0.1:3101
}
