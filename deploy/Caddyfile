# Caddy: HTTPS for the three public addresses, and the reverse proxy to the three local processes.
# Set up for voxelventure.app. DNS A records (at GoDaddy) point at the Linode: @, api and play under voxelventure.app, and www
# under both voxelventure.app and voxelventure.net plus @ under voxelventure.net for the redirects at the end.
# Caddy gets and renews the certificates by itself. .app is HTTPS-only in every browser, which Caddy handles.

# The game (Next.js).
voxelventure.app {
	encode zstd gzip

	# The presence monitor page has no login of its own: put a password on it.
	# Make the hash with:  caddy hash-password
	# /mp-status is the presence server's /status, reached through this protected address (the monitor page reads it:
	# NEXT_PUBLIC_MP_HTTP in web.env).
	@monitor path /admin /admin/* /mp-status
	basic_auth @monitor {
		admin REPLACE_WITH_A_CADDY_HASH
	}

	handle /mp-status {
		rewrite * /status
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# The API.
api.voxelventure.app {
	encode zstd gzip
	# The API reads the visitor's address from X-Forwarded-For (TRUST_PROXY=1 in api.env), which Caddy sets.
	# /internal/* is for the other processes on this machine (the presence server, the messaging service): never from outside.
	@internal path /internal /internal/*
	respond @internal 404
	reverse_proxy 127.0.0.1:3002
}

# Presence (WebSockets). Only the game's connection and the health check are public: /status lists every
# connected player, and /notify and /notify-accounts are for the API on this machine, so none is reachable from outside.
play.voxelventure.app {
	@private path /status /status/* /notify /notify/* /notify-accounts /notify-accounts/*
	respond @private 404

	reverse_proxy 127.0.0.1:3001
}

# The other names send visitors to the one address (a permanent redirect keeps search engines on voxelventure.app).
# Remove a name here if it has no A record, or Caddy keeps retrying its certificate.
www.voxelventure.app, voxelventure.net, www.voxelventure.net {
	redir https://voxelventure.app{uri} permanent
}
