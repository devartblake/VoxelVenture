# /etc/voxelventure/web.env  (copy there, then: chmod 640, chown root:voxel)
# These NEXT_PUBLIC_ values are fixed into the page when it is BUILT: run `npm run build` with this file loaded
# (see deploy/README.md), and build again whenever you change them.
NODE_ENV=production

# The API the game talks to. With this set the game is shared (accounts, claims, statistics); without it it is single-player.
NEXT_PUBLIC_LIVE_API_URL=https://api.example.com
# The site's own address: canonical links, share images and the sitemap of the public business pages (docs/product/business_funnel.md).
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional: the address the web server itself uses to read the API (e.g. http://127.0.0.1:3002 on the same machine). Defaults to NEXT_PUBLIC_LIVE_API_URL.
# API_URL=http://127.0.0.1:3002
# The presence server, as a WebSocket address.
NEXT_PUBLIC_MP_URL=wss://play.example.com
# Or, with several presence servers: a list, comma separated. Each city always goes to the same one (see docs/architecture/presence_scale.md).
# NEXT_PUBLIC_MP_URLS=wss://play1.example.com,wss://play2.example.com
# Where the /admin monitor page reads the connected players from (the password-protected address in the Caddyfile).
NEXT_PUBLIC_MP_HTTP=https://example.com/mp-status

# Who runs the service, for the policies at /legal (lib/legal/operator.js). Unset ones show as [placeholders] on the draft pages, and
# the policies cannot be approved until all are set (docs/monetization/policy_review.md).
# NEXT_PUBLIC_LEGAL_NAME=Example Ltd
# NEXT_PUBLIC_LEGAL_ADDRESS=1 Example Street, Example Town
# NEXT_PUBLIC_LEGAL_EMAIL=legal@example.com
# NEXT_PUBLIC_LEGAL_JURISDICTION=the laws of England and Wales, and its courts
# NEXT_PUBLIC_LEGAL_MIN_AGE=16
