# /etc/voxelventure/presence.env  (copy there, then: chmod 600, chown root:voxel)
NODE_ENV=production

MP_PORT=3001
# Listen on this machine only: Caddy is the public face (wss://play.voxelventure.app).
MP_HOST=127.0.0.1
# The same secret as MP_NOTIFY_SECRET in api.env: the API uses it to tell this server that something changed.
MP_NOTIFY_SECRET=CHANGE_ME_SAME_AS_IN_api.env
# The same IP_SALT as in api.env: network addresses are only ever kept and shown as a salted hash (services/multiplayer/README.md).
IP_SALT=CHANGE_ME_SAME_AS_IN_api.env
# Caddy is in front: take the player's address from X-Forwarded-For (otherwise everyone is 127.0.0.1 and shares MP_MAX_PER_IP).
TRUST_PROXY=1

# Limits. Players beyond MP_VIEW_RADIUS are not sent to each other; chat is heard within MP_CHAT_RADIUS.
MP_MAX_CLIENTS=1000
MP_MAX_PER_IP=20
MP_VIEW_RADIUS=120
# The most other players one client is told about (the nearest). Lower it (30, 25) to cut bandwidth in a crowd.
MP_MAX_VISIBLE=40
MP_CHAT_RADIUS=60
MP_LOG_DIR=/srv/voxelventure/services/multiplayer/logs

# Chat (docs/architecture/chat_messaging_plan.md). The API checks who is speaking, the filter, blocks and reports; it is reached with MP_NOTIFY_SECRET.
MP_API_URL=http://127.0.0.1:3002
# Only signed-in players may chat (1 lets guests chat too: for a trusted LAN only).
MP_CHAT_GUESTS=0
# Only your game's page may connect (a browser says which page opened the connection).
MP_ORIGINS=https://voxelventure.app
# MP_CHAT=0 switches nearby chat off (it stays readable).

# Error reporting (deploy/MONITORING.md): the DSN from Sentry > Project settings > Client Keys. The same one in api.env, presence.env and
# web.env; each error is tagged with the process it came from. Without it, errors stay in journalctl only.
# This server also passes on the players' app errors it collects (not their names or networks).
# SENTRY_DSN=https://KEY@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
