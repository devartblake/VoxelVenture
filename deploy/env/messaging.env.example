# /etc/voxelventure/messaging.env  (copy there, then: chmod 640, chown root:voxel)
# The Python messaging service (services/messaging). It runs only after the switch-over in docs/architecture/node_fastapi_architecture_plan.md:
# until then the Node API serves messaging itself and this file is not used.

MESSAGING_PORT=3003
# Listen on this machine only: the Node API forwards the messaging routes here.
MESSAGING_HOST=127.0.0.1
MESSAGING_DB=/srv/voxelventure/services/messaging/data/messaging.db
# The Node API: accounts, sign-ins, bans and who owns a building are asked of it.
NODE_API_URL=http://127.0.0.1:3002
# The same value as INTERNAL_SECRET in api.env.
INTERNAL_SECRET=CHANGE_ME_SAME_AS_IN_api.env
# "Your inbox changed" notices go to the presence server (its /notify-accounts, next to /notify); the same secret as presence.env.
MP_NOTIFY_URL=http://127.0.0.1:3001/notify
MP_NOTIFY_SECRET=CHANGE_ME_SAME_AS_IN_presence.env
# The moderators' queue for chat reports (npm run moderate with MESSAGING_URL=http://127.0.0.1:3003).
ADMIN_TOKEN=CHANGE_ME_SAME_AS_IN_api.env
API_ORIGIN=https://example.com
TRUST_PROXY=1

# Switches and limits: the same names and defaults as in api.env.
# MESSAGING_NEARBY=1
# MESSAGING_INBOX=1
# MESSAGING_INQUIRIES=1
# MESSAGING_SENDS_PER_MINUTE=20
# MESSAGING_NEW_PER_DAY=5
# MESSAGING_NEARBY_DAYS=7
# MESSAGING_INBOX_DAYS=90
# MESSAGING_REPORT_DAYS=180
# MODERATION_WORDS_FILE=/etc/voxelventure/words.txt
# MODERATION_WEBHOOK_URL=
# MODERATION_WEBHOOK_TOKEN=
