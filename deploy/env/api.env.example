# /etc/voxelventure/api.env  (copy this file there, fill it in, then: chmod 600, chown root:voxel)
NODE_ENV=production

API_PORT=3002
# Listen on this machine only: Caddy is the public face.
API_HOST=127.0.0.1
# The database file (SQLite), outside the releases so every deploy and rollback keeps it (deploy/production.sh). Back it up: deploy/backup.sh.
API_DB=/srv/voxelventure/shared/data/voxelventure.db
# Emails written as files (when no mail service is set), beside the database.
MAIL_DIR=/srv/voxelventure/shared/data/outbox
# The world's seed. It must be the game's seed (20260101 unless you changed DEFAULT_SEED in lib/state/store.js), or plot ids will not match the game.
API_SEED=20260101
# Which website may call the API (CORS): your game's address, no trailing slash.
API_ORIGIN=https://voxelventure.app
# The API's own public address (used in the links inside emails).
PUBLIC_API_URL=https://api.voxelventure.app

# Secrets: make each one long and random, e.g.  openssl rand -hex 32
# ADMIN_TOKEN is the machine credential for the /admin routes (npm run moderate, verify:live) and what creates the first admin account at
# /admin/setup. The admins themselves sign in at /admin/login: their accounts are in the database, never in this file (deploy/README.md).
ADMIN_TOKEN=CHANGE_ME
IP_SALT=CHANGE_ME
MP_NOTIFY_SECRET=CHANGE_ME_SAME_AS_IN_presence.env
# Signs referral codes (?ref= links, docs/product/business_funnel.md). Changing it voids every link already shared.
REFERRAL_SECRET=CHANGE_ME

# Welcome posts on VoxelVenture's X account (docs/operations/social_posts.md): off, review (an admin approves each) or auto.
SOCIAL_POSTS=off
PUBLIC_SITE_URL=https://voxelventure.app
# X_API_KEY= / X_API_SECRET= / X_ACCESS_TOKEN= / X_ACCESS_SECRET=   (an X developer app with read and write access)
# SOCIAL_MAX_PER_DAY=20

# Payments through Stripe Checkout (docs/monetization/billing.md): the Launch Pack, Pro and sponsored placements. Leave the key empty to keep
# payments off. With a key, the webhook secret and PUBLIC_SITE_URL are required, and a live key also needs the two policy addresses.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (Stripe > Developers > Webhooks, endpoint https://api.voxelventure.app/billing/webhook)
# TERMS_URL=https://voxelventure.app/legal/terms
# REFUND_POLICY_URL=https://voxelventure.app/legal/refunds

# Behind Caddy: read the visitor's address from X-Forwarded-For (proof-of-human limits and the per-address rate limits depend on it).
TRUST_PROXY=1

# Tell the presence server about claims, take-overs and ad purchases so every connected game refreshes at once.
MP_NOTIFY_URL=http://127.0.0.1:3001/notify
# The presence server's /status, which the /admin monitor reads through this API (GET /admin/presence, signed-in admins only). By default
# MP_NOTIFY_URL with /status in place of /notify, so this is only needed if the presence server is somewhere else.
# MP_STATUS_URL=http://127.0.0.1:3001/status

# Email. With no MAIL_WEBHOOK_URL, messages are only written to files in services/api/data/outbox (nothing is delivered).
# Resend (resend.com) takes this format as it is: verify voxelventure.app there first (its DNS records go in GoDaddy), then
# put the API key (re_...) in MAIL_WEBHOOK_TOKEN. Any other mail API that takes { from, to, subject, text } works the same way.
# MAIL_FROM=VoxelVenture <no-reply@voxelventure.app>
# MAIL_WEBHOOK_URL=https://api.resend.com/emails
# MAIL_WEBHOOK_TOKEN=re_CHANGE_ME

# The Python messaging service, after the switch-over (docs/architecture/node_fastapi_architecture_plan.md): this API then forwards the messaging
# routes to it and stops doing messaging itself. Leave MESSAGING_SERVICE_URL empty until then. INTERNAL_SECRET: long and random,
# the same in messaging.env.
# MESSAGING_SERVICE_URL=http://127.0.0.1:3003
# INTERNAL_SECRET=CHANGE_ME_SAME_AS_IN_messaging.env

# Chat and private messages (services/api/messaging.mjs). Each part can be switched off (0); the limits are the starting values in the plan.
# MESSAGING_NEARBY=1
# MESSAGING_INBOX=1
# MESSAGING_INQUIRIES=1
# MESSAGING_SENDS_PER_MINUTE=20
# MESSAGING_NEW_PER_DAY=5
# How long messages are kept, in days: nearby lines (as evidence for reports), private messages, and report evidence after a decision.
# MESSAGING_NEARBY_DAYS=7
# MESSAGING_INBOX_DAYS=90
# MESSAGING_REPORT_DAYS=180

# Optional: how many meeting and quote requests one network can send in a day, across every profile (docs/monetization/conversions.md).
# INQUIRY_LIMIT=10
# How long the contact details in a meeting or quote request are kept, in days (then wiped; the counts stay).
# INQUIRY_DAYS=180

# Optional: how many verified human visits and clicks one network can add to a building in a day.
# HUMAN_VISIT_CAP=3
# HUMAN_CLICK_CAP=1
# Optional: an outside image-moderation service, and a longer word list (one word per line).
# MODERATION_WEBHOOK_URL=
# MODERATION_WEBHOOK_TOKEN=
# MODERATION_WORDS_FILE=/etc/voxelventure/words.txt

# Error reporting (deploy/MONITORING.md): the DSN from Sentry > Project settings > Client Keys. The same one in api.env, presence.env and
# web.env; each error is tagged with the process it came from. Without it, errors stay in journalctl only.
# SENTRY_DSN=https://KEY@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
