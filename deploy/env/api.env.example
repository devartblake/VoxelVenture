# /etc/voxelventure/api.env  (copy this file there, fill it in, then: chmod 600, chown root:voxel)
NODE_ENV=production

API_PORT=3002
# Listen on this machine only: Caddy is the public face.
API_HOST=127.0.0.1
# The database file (SQLite). Back it up: see deploy/backup.sh.
API_DB=/srv/voxelventure/server/data/voxelventure.db
# The world's seed. It must be the game's seed (20260101 unless you changed DEFAULT_SEED in lib/state/store.js), or plot ids will not match the game.
API_SEED=20260101
# Which website may call the API (CORS): your game's address, no trailing slash.
API_ORIGIN=https://example.com
# The API's own public address (used in the links inside emails).
PUBLIC_API_URL=https://api.example.com

# Secrets: make each one long and random, e.g.  openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME
IP_SALT=CHANGE_ME
MP_NOTIFY_SECRET=CHANGE_ME_SAME_AS_IN_presence.env
# Signs referral codes (?ref= links, docs/business_funnel.md). Changing it voids every link already shared.
REFERRAL_SECRET=CHANGE_ME

# Welcome posts on VoxelVenture's X account (docs/social_posts.md): off, review (an admin approves each) or auto.
SOCIAL_POSTS=off
# PUBLIC_SITE_URL=https://example.com
# X_API_KEY= / X_API_SECRET= / X_ACCESS_TOKEN= / X_ACCESS_SECRET=   (an X developer app with read and write access)
# SOCIAL_MAX_PER_DAY=20

# Payments through Stripe Checkout (docs/billing.md): the Launch Pack, Pro and sponsored placements. Leave the key empty to keep
# payments off. With a key, the webhook secret and PUBLIC_SITE_URL are required, and a live key also needs the two policy addresses.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (Stripe > Developers > Webhooks, endpoint https://<api host>/billing/webhook)
# TERMS_URL=https://example.com/terms
# REFUND_POLICY_URL=https://example.com/refunds

# Behind Caddy: read the visitor's address from X-Forwarded-For (proof-of-human limits and the per-address rate limits depend on it).
TRUST_PROXY=1

# Tell the presence server about claims, take-overs and ad purchases so every connected game refreshes at once.
MP_NOTIFY_URL=http://127.0.0.1:3001/notify

# Email. With no MAIL_WEBHOOK_URL, messages are only written to files in server/data/outbox (nothing is delivered).
# MAIL_FROM=VoxelVenture <hello@example.com>
# MAIL_WEBHOOK_URL=https://your-mail-service.example/send
# MAIL_WEBHOOK_TOKEN=

# The Python messaging service, after the switch-over (docs/node_fastapi_architecture_plan.md): this API then forwards the messaging
# routes to it and stops doing messaging itself. Leave MESSAGING_SERVICE_URL empty until then. INTERNAL_SECRET: long and random,
# the same in messaging.env.
# MESSAGING_SERVICE_URL=http://127.0.0.1:3003
# INTERNAL_SECRET=CHANGE_ME_SAME_AS_IN_messaging.env

# Chat and private messages (server/api/messaging.mjs). Each part can be switched off (0); the limits are the starting values in the plan.
# MESSAGING_NEARBY=1
# MESSAGING_INBOX=1
# MESSAGING_INQUIRIES=1
# MESSAGING_SENDS_PER_MINUTE=20
# MESSAGING_NEW_PER_DAY=5
# How long messages are kept, in days: nearby lines (as evidence for reports), private messages, and report evidence after a decision.
# MESSAGING_NEARBY_DAYS=7
# MESSAGING_INBOX_DAYS=90
# MESSAGING_REPORT_DAYS=180

# Optional: how many meeting and quote requests one network can send in a day, across every profile (docs/conversions.md).
# INQUIRY_LIMIT=10
# How long the contact details in a meeting or quote request are kept, in days (then wiped; the counts stay).
# INQUIRY_DAYS=180

# Optional: how many verified human visits and clicks one network can add to a building in a day.
# HUMAN_VISIT_CAP=3
# HUMAN_CLICK_CAP=1
# Optional: an outside image-moderation service, and a longer word list (one word per line).
# MODERATION_WEBHOOK_URL=
# MODERATION_WEBHOOK_TOKEN=
# MODERATION_WORDS_FILE=/etc/voxelventure/words.txt
