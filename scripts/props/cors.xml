<!-- The props bucket's CORS rules (scripts/props/upload.mjs): the site and staging may fetch the props (the .glb models) from the page.
     s3cmd setcors scripts/props/cors.xml s3://vv-asset-prod        and check with: s3cmd info s3://vv-asset-prod -->
<CORSConfiguration>
  <CORSRule>
    <AllowedOrigin>https://voxelventure.app</AllowedOrigin>
    <AllowedOrigin>https://staging.voxelventure.app</AllowedOrigin>
    <AllowedMethod>GET</AllowedMethod>
    <AllowedMethod>HEAD</AllowedMethod>
    <AllowedHeader>*</AllowedHeader>
    <MaxAgeSeconds>86400</MaxAgeSeconds>
  </CORSRule>
</CORSConfiguration>
